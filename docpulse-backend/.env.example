# Copy this file to .env and fill in real values. Never commit the real .env file.

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/docpulse"

# Server
PORT=5000
NODE_ENV=development

# CORS - the exact origin(s) your frontend runs on, comma separated
CORS_ORIGIN="http://localhost:5173"

# Auth
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Bootstrap: the very first admin doctor account is created automatically
# on first server start if no user with this email exists yet.
BOOTSTRAP_ADMIN_NAME="Dr. Zahid Hussain"
BOOTSTRAP_ADMIN_EMAIL="admin@docpulse.local"
BOOTSTRAP_ADMIN_PASSWORD="ChangeMe123!"
BOOTSTRAP_ADMIN_PHONE="0300-0000000"

# Optional: Anthropic API key for the AI clinical summary feature.
# If left empty, /api/ai/clinical-summary returns a locally generated
# (non-AI) summary instead of failing.
ANTHROPIC_API_KEY=""
