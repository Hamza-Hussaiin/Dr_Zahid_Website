# Optional. Only needed if your backend runs on a different origin than the
# frontend AND you don't want to use the dev proxy in vite.config.ts.
#
# Leave this unset (or delete the file) to keep using relative "/api/..." paths:
#   - in dev, they'll be forwarded by the proxy in vite.config.ts (default target
#     http://localhost:5000 — change it there to match your backend's port)
#   - in production, they'll resolve correctly if your backend serves this built
#     frontend from the same origin
#
# Set it if your backend lives elsewhere (e.g. a separate deployed API):
# VITE_API_URL=http://localhost:5000
